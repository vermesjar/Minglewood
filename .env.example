# Minglewood configuration. Copy to .env and fill in what you need.
# Nothing here is required for demo mode — `npm run dev` works with an empty .env.

# --- Server -----------------------------------------------------------------
# Port for the API/realtime server (Vite dev server runs on 5173 and proxies to it).
API_PORT=8787
# Public origin users reach the app on (used for OAuth redirects).
PUBLIC_URL=http://localhost:5173
# Required in production. In dev a secret is generated into .data/ automatically.
SESSION_SECRET=
# Where the JSON dev store lives (gitignored).
DATA_DIR=.data

# --- Demo -------------------------------------------------------------------
# Show "Enter the demo" on the sign-in page and allow guest accounts.
DEMO_MODE=true
# Drive the seeded Northstar Labs coworkers with the life simulator.
SIMULATE_COWORKERS=true

# --- Discord (see docs/DISCORD.md) ------------------------------------------
# From https://discord.com/developers/applications → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot → Reset Token. Only "View Channels" permission and the GUILD_VOICE_STATES intent are used.
DISCORD_BOT_TOKEN=
# Must be registered under OAuth2 → Redirects.
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
# Optional: pre-connect this server (guild) id instead of connecting from the admin console.
DISCORD_GUILD_ID=
# Optional: comma-separated Discord user ids that become Minglewood admins on first sign-in.
DISCORD_ADMIN_USER_IDS=

# --- Slack (see docs/slack.md) ---------------------------------------------
# From https://api.slack.com/apps → your app → Basic Information → App Credentials
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Verifies every request Slack sends (events, /minglewood, interactions).
SLACK_SIGNING_SECRET=
# OAuth & Permissions → Bot User OAuth Token (xoxb-…). Optional if you use "Add to Slack" in the admin console.
SLACK_BOT_TOKEN=
# Optional: the workspace id (T…) this world belongs to, so people can sign in before anything is connected.
SLACK_TEAM_ID=
# Optional: comma-separated Slack user ids that become Minglewood admins (workspace owners/admins already do).
SLACK_ADMIN_USER_IDS=
# Optional overrides; default to PUBLIC_URL + /api/slack/auth/callback and /api/slack/install/callback.
# SLACK_REDIRECT_URI=
# SLACK_INSTALL_REDIRECT_URI=
# Local development without a workspace: record outgoing Slack calls instead of sending them (never in production).
SLACK_MOCK=false
